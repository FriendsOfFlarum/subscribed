{
    "name": "fof/subscribed",
    "description": "Additional user subscriptions for your forum",
    "keywords": [
        "extension",
        "flarum",
        "fof",
        "friendsofflarum",
        "subscriptions"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/subscribed/issues",
        "source": "https://github.com/FriendsOfFlarum/subscribed",
        "forum": "https://discuss.flarum.org/d/20917"
    },
    "homepage": "https://friendsofflarum.org",
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "authors": [
        {
            "name": "FoF Team",
            "email": "team@friendsofflarum.org",
            "role": "developer"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0"
    },
    "replace": {
        "flagrow/subscribed": "*"
    },
    "extra": {
        "flarum-extension": {
            "title": "FoF Subscribed",
            "category": "feature",
            "icon": {
                "name": "fas fa-reply-all",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/approval",
                "flarum/flags"
            ]
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        },
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "FoF\\Subscribed\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FoF\\Subscribed\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0.0",
        "flarum/testing": "^2.0",
        "flarum/flags": "*",
        "flarum/approval": "*"
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis",
        "test": "Run all tests",
        "test:unit": "Run unit tests",
        "test:integration": "Run integration tests",
        "test:setup": "Set up the integration test database"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
